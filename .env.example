# AGASTYA Environment Configuration Template
# ==========================================

# ─── FRONTEND (Vite / React) ───────────────────────────────
# For Local Development (automatically defaults if commented out):
# VITE_API_BASE=http://localhost:8000
#
# For Cloud Production Deployment (e.g., Render backend paired with Vercel frontend):
# Replace with your actual public Render backend URL:
VITE_API_BASE=https://agastya-backend.onrender.com

# ─── BACKEND (FastAPI / Uvicorn) ───────────────────────────
# Server bind address (0.0.0.0 for containers / cloud platforms):
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# CORS Allowed Origins (Production):
# Comma-separated list of production frontend origins allowed to access the API.
# Local origins (localhost:5173, 127.0.0.1:5173, 3000, 4173) and *.vercel.app are automatically permitted.
# Set this on Render to your production Vercel domain or custom domain:
FRONTEND_ORIGIN=https://agastya.vercel.app

